# Tokens for silverjs_buffers: steps of three bytes (step, view,
# action), the actions that detach (4), shrink (8) and grow (12).
detach="\x04\x00\x04"
shrink="\x04\x00\x08"
grow="\x04\x00\x0c"
fill_detaching="\x05\x00\x04"
sort_shrinking="\x0c\x00\x08"
iterate_detaching="\x1a\x00\x04"
set_like="\x07\x00\x05"
new_view="\x03\x01\x06"
new_data_view="\x1f\x00\x01"
data_view_set_detaching="\x20\x00\x04"
atomics_add_shrinking="\x23\x00\x08"
wait_and_notify="\x26\x01\x05"
base64_detaching="\x27\x00\x04"
bigint_write_shrinking="\x2b\x00\x04"
data_view_bigint_set_detaching="\x2c\x00\x04"
bigint_fill_shrinking="\x2e\x00\x04"
atomics_bigint_add_shrinking="\x2f\x00\x08"
check="\x31\x00\x00"
